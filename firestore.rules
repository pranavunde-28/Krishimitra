rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOfficer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'officer';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'farmer';
      allow update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role']);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.category in ['crop-tips', 'disease-help', 'market', 'equipment', 'schemes'];
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotes', 'upvotedBy', 'commentCount'])
        && request.resource.data.upvotes is int
        && request.resource.data.upvotes >= 0
        && request.resource.data.upvotedBy is list
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 3000;
        allow update, delete: if false;
      }
    }

    match /diseaseReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.farmerUid == request.auth.uid
        && request.resource.data.farmerName is string
        && request.resource.data.cropType is string
        && request.resource.data.diseaseName is string
        && request.resource.data.status == 'new'
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lon is number
        && request.resource.data.lon >= -180
        && request.resource.data.lon <= 180;
      allow update: if isOfficer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'reviewing', 'contained'];
      allow delete: if false;
    }
  }
}
